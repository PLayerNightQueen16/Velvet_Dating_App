# VELVET Client Environment Configuration
# Local Development default: http://localhost:8000/api
# Production (Render) example: https://velvet-api.onrender.com/api
VITE_API_URL=http://localhost:8000/api

# Optional: Dedicated Socket.IO Server URL (defaults to VITE_API_URL origin if omitted)
# Example: https://velvet-api.onrender.com
VITE_SERVER_URL=http://localhost:8000
