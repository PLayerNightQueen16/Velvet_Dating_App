# VELVET Server Environment Variables (Placeholder Example)
# Copy this file to .env and fill in real values

PORT=5000
NODE_ENV=development

# MongoDB Atlas URI (replace placeholders with real Atlas credentials)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/velvet?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_jwt_secret_key
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Cookie Signing Secret
COOKIE_SECRET=replace_with_a_long_random_cookie_signing_secret

# Optional Cloudinary Media Storage (Mandatory 3 pics, max 5 pics per user)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
