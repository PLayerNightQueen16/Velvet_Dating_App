# VELVET Server Environment Configuration
# Copy this file to .env and configure for local development or production

PORT=8000
NODE_ENV=development

# MongoDB Atlas or Local MongoDB URI
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/velvet?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/velvet_dev

# JWT Authentication & Cookie Security
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_long_random_cookie_signing_secret

# CORS Allowed Client Origin (comma-separated for multiple origins, e.g. Vercel URL + localhost)
CLIENT_URL=http://localhost:5173,https://your-velvet-app.vercel.app

# Cloudinary Media Storage (for profile photo uploads: min 3, max 5)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Demo Seeding Safety Gates (Optional)
SEED_DEMO_PROFILES=false
ALLOW_PRODUCTION_DEMO_SEED=false
